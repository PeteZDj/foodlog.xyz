{
  "expo": {
    "name": "Foodlog",
    "slug": "foodlog",
    "version": "1.6.0",
    "orientation": "portrait",
    "scheme": "foodlog",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F5F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "xyz.foodlog.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Foodlog uses your camera so you can snap a photo of your plate to log meals.",
        "NSPhotoLibraryUsageDescription": "Foodlog uses your photo library so you can attach meal photos to your log."
      }
    },
    "android": {
      "package": "xyz.foodlog.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D10"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "foodlog.xyz",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.foodlog.xyz",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Foodlog to access your photos to attach meal pictures.",
          "cameraPermission": "Allow Foodlog to use your camera to photograph meals."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "updateManifestUrl": "https://foodlog.xyz/downloads/versions.json",
      "updateSlug": "foodlog",
      "updateAccent": "#0B0D10"
    }
  }
}
