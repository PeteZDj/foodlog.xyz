{
  "expo": {
    "name": "Foodlog",
    "slug": "foodlog-rn",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foodlog",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F5F2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.foodlog.app"
    },
    "android": {
      "package": "xyz.foodlog.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#17643A",
        "foregroundImage": "./assets/images/adaptive-foreground.png"
      },
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Foodlog uses your photos so you can log meals from pictures.",
          "cameraPermission": "Foodlog uses the camera to scan and log your meals."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "updateManifestUrl": "https://foodlog.xyz/downloads/versions.json",
      "updateSlug": "foodlog",
      "updateAccent": "#2E9E5B"
    }
  }
}
